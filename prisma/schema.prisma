generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum chunithmDifficulty {
  BAS
  ADV
  EXP
  MAS
  ULT
}

model tokenSession {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   // Discord user ID
  expiresAt DateTime

  @@map("tokenSessions")
}

model availability {
  id     String   @id @default(uuid())
  userId String
  date   DateTime @db.Date // Store only the date part, without time
  createdAt DateTime @default(now())

  @@unique([userId, date])
  @@index([date])
  @@map("availabilities")
}

model chunithmSong {
  id            Int                 @id @default(autoincrement())
  title         String
  artist        String
  genre         String
  const         Float
  difficulty    chunithmDifficulty
  chunirec_id   String
  notes         Int
  unknown       Boolean
  search_terms  String
}
